# Copy to .env and fill the keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

DEFAULT_MODEL=groq/llama-3.1-70b-versatile
OPENROUTER_MODEL=openrouter/google/gemma-3-12b-it:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Pratibha
OPENAI_MODEL=gpt-4o-mini
REQUEST_TIMEOUT_S=20
MAX_RETRIES=2
EMBEDDING_MODEL=text-embedding-3-small

# RAG
USE_RAG=false
VECTOR_BACKEND=pgvector
RAG_FETCH_K=20
RAG_MIN_SCORE=0.2

# Postgres (docker compose provides these defaults)
PG_HOST=localhost
PG_PORT=5432
PG_DB=pratibha
PG_USER=postgres
PG_PASSWORD=postgres
PG_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/pratibha
