# Copy to .env and fill in at least one chat provider key.
# cp .env.example .env

# --- Chat (OpenRouter only) ---
# Chat runs exclusively on OpenRouter. Set OPENROUTER_API_KEY.
# OPENAI_API_KEY is used ONLY for RAG embeddings (optional, higher quality).
# GROQ_API_KEY is deprecated and ignored for chat.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Chat model (any OpenRouter id; keep the openrouter/ prefix). Default is a
# cheap, fast, voice-faithful model that returns well inside the timeout.
DEFAULT_MODEL=openrouter/anthropic/claude-haiku-4.5
OPENROUTER_MODEL=openrouter/anthropic/claude-haiku-4.5
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Pratibha

# Per-request timeout (s) and retries. Keep timeout under the client's patience.
REQUEST_TIMEOUT_S=18
MAX_RETRIES=1
CHAT_MAX_TOKENS=700
# Per-IP chat rate limit (requests/minute). 0 disables.
CHAT_RATE_MAX_PER_MIN=20
# Optional: gate /admin/corpus-status behind a shared secret (X-Admin-Token).
# ADMIN_TOKEN=
EMBEDDING_MODEL=text-embedding-3-small

# --- RAG (optional; false = corpus from disk only, no Postgres) ---
# In production (live Study chat with retrieval) set this to true.
USE_RAG=false
VECTOR_BACKEND=pgvector
RAG_FETCH_K=20
RAG_MIN_SCORE=0.2

# --- Postgres ---
# LOCAL DEV: discrete fields below match docker compose.
PG_HOST=localhost
PG_PORT=5432
PG_DB=pratibha
PG_USER=postgres
PG_PASSWORD=postgres
PG_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/pratibha
#
# PRODUCTION: set a single DATABASE_URL instead (Railway/Render/Supabase/Neon
# all expose one). It is parsed into the PG_* fields above and wins over them.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Set PG_SSL=true (or append ?sslmode=require to the URL) when connecting to a
# managed database over the public internet (e.g. the one-time ingest from your
# laptop). Internal/private networking between app and DB does not need it.
# DATABASE_URL=
# PG_SSL=false

# --- CORS (production) ---
# Comma-separated list of allowed frontend origins. Leave unset/"*" for local
# dev; lock to your deployed frontend in production.
#   CORS_ALLOW_ORIGINS=https://pratibha.vercel.app,https://pratibha.agniagama.com
# CORS_ALLOW_ORIGINS=

# --- Supabase Auth (email + Google) ---
# Project Settings → API:
#   SUPABASE_URL = Project URL
#   NEXT_PUBLIC_SUPABASE_* = Project URL + anon/public key (web build)
# Backend verifies user access tokens via JWKS at
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Optional legacy HS256 secret (JWT Settings → JWT Secret). Do NOT paste the
# anon or service_role API keys here — those start with eyJ and are not signing secrets.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_JWT_SECRET=
# Web (also set in Cloudflare / web/.env.production):
#   NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Email + Google under Authentication → Providers. Add redirect URLs:
#   http://localhost:3000/auth/callback
#   https://pratibha.agniagama.com/auth/callback

# --- Web -> API base URL ---
# The Next.js app reads NEXT_PUBLIC_API_BASE at BUILD time. dev.sh sets it
# locally; on Vercel set it to your deployed backend URL (no trailing slash).
#   NEXT_PUBLIC_API_BASE=https://pratibha-api.onrender.com
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# --- Mobile (set when running Expo on a physical device) ---
# EXPO_PUBLIC_API_BASE=http://192.168.x.x:8000
