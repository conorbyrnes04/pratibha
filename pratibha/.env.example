# Convex Auth
# Set these in Convex dashboard: Settings -> Environment Variables
# Or use: npx convex env set AUTH_GOOGLE_ID <your-client-id>
#         npx convex env set AUTH_GOOGLE_SECRET <your-client-secret>

# Convex deployment URL (from Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=

# Google OAuth
# Official Convex Auth env vars:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Legacy aliases (also supported):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Site URL for OAuth redirects (optional, defaults to deployment URL)
SITE_URL=

# FastAPI/RAG (if using corpus features)
API_BASE_URL=http://localhost:8000

# Google OAuth Setup:
# 1. Create OAuth client in Google Cloud Console (Web Application type)
# 2. Add authorized redirect URI: https://<your-deployment>.convex.site/api/auth/callback/google
#    Note: Use .convex.site (not .convex.cloud) - find your HTTP Actions URL in Convex dashboard
# 3. Set AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET in Convex dashboard
# 4. Authorized JavaScript origins: http://localhost:3000 (for local dev)
