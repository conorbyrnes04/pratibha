# Large files that shouldn't be in git
*.pdf
*.epub
*.mobi
*.azw3

# Source book binaries (epub/pdf/mobi) are NEVER tracked — many are
# in-copyright editions kept only as a local, private reference for the
# provenance divergence-check, not for distribution. Do not re-add negations
# for data/raw_texts/*.pdf|*.epub here. Processed .txt extracts are fine:
!data/raw_texts/*.txt

# Docker
.dockerignore

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Re-fetchable PD bulk sources (keep manifest.yml)
data/raw_texts/pd/
!data/raw_texts/pd/manifest.yml
data/raw_texts.zip

# Booklet working copies (keep source .md / build scripts)
data/booklet/*.backup*.docx
data/booklet/~$*

