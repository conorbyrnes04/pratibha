# Keep the Render/Docker build context tiny. The image only needs
# app/, data/canonical/, scripts/{start_api,ingest_pgvector}.py, db/, requirements.txt.

.git
.github
.cursor
.venv
venv
__pycache__
*.pyc
.env
.env.*
!.env.example

# Frontend is deployed to Cloudflare — never bake it into the API image.
web
mobile
node_modules
.open-next
.next
.wrangler

# Authoring / bulk source material (not loaded at API runtime).
data/raw_texts
data/yaml
data/pratibha_md
data/booklet
data/reports
data/rework
data/paths
data/canonical.zip
dist-share

# Local docs / tooling noise.
*.md
!requirements.txt
docs
tests
scripts/*
!scripts/start_api.sh
!scripts/ingest_pgvector.py
!scripts/bake_catalog.py

# Glyphs / art live on the frontend.
**/.DS_Store
**/*.pdf
**/*.epub
